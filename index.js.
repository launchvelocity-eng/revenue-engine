const server = http.createServer(async (req, res) => {
  if (req.method === 'GET' && req.url === '/') {
    res.writeHead(200, { 'Content-Type': 'text/html' });
    res.end(htmlTemplate);
    return;
  }

  res.setHeader('Content-Type', 'application/json');

  if (req.method === 'POST' && req.url === '/signup') {
    let body = '';
    req.on('data', chunk => {
      body += chunk.toString();
    });
    
    req.on('end', async () => {
      try {
        const parsed = JSON.parse(body);
        const email = parsed.email;

        if (!email) {
          res.writeHead(400);
          res.end(JSON.stringify({ status: 'error', message: 'Email is required' }, null, 2));
          return;
        }

        const insertQuery = 'INSERT INTO users (email) VALUES ($1) RETURNING *';
        const result = await pool.query(insertQuery, [email]);

        res.writeHead(201);
        res.end(JSON.stringify({
          status: 'success',
          message: 'User registered successfully!',
          user: result.rows[0]
        }, null, 2));
      } catch (err) {
        res.writeHead(500);
        res.end(JSON.stringify({ status: 'error', message: err.message }, null, 2));
      }
    });
    return;
  }

  if (req.method === 'GET' && req.url === '/users') {
    try {
      const result = await pool.query('SELECT * FROM users ORDER BY created_at DESC');
      res.writeHead(200);
      res.end(JSON.stringify({
        status: 'success',
        count: result.rowCount,
        users: result.rows
      }, null, 2));
    } catch (err) {
      res.writeHead(500);
      res.end(JSON.stringify({ status: 'error', message: err.message }, null, 2));
    }
    return;
  }

  res.writeHead(404);
  res.end(JSON.stringify({ status: 'error', message: 'Not Found' }, null, 2));
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
  console.log(`Server is running on port ${PORT}`);
});

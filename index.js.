const { Pool } = require('pg');
const http = require('http');
const url = require('url');
const { Resend } = require('resend');

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: {
    rejectUnauthorized: false
  },
  connectionTimeoutMillis: 10000
});

const resend = new Resend(process.env.RESEND_API_KEY);

const server = http.createServer(async (req, res) => {
  const parsedUrl = url.parse(req.url, true);

  // Example route to handle signups and send email
  if (req.method === 'POST' && parsedUrl.pathname === '/api/signup') {
    let body = '';
    req.on('data', chunk => { body += chunk; });
    req.on('end', async () => {
      try {
        const { email } = JSON.parse(body);
        
        // 1. Save to database
        await pool.query('INSERT INTO waitlist (email) VALUES ($1)', [email]);

        // 2. Send email via Resend
        await resend.emails.send({
          from: 'onboarding@resend.dev', // Replace with your verified domain if you have one
          to: email,
          subject: 'Welcome to the Waitlist!',
          html: '<p>Thanks for signing up! We are excited to have you.</p>'
        });

        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ success: true, message: 'Saved and email sent!' }));
      } catch (error) {
        console.error(error);
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ success: false, error: error.message }));
      }
    });
  } else {
    res.writeHead(200, { 'Content-Type': 'text/plain' });
    res.end('Revenue Engine API with Resend is running!\n');
  }
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
  console.log(`Server listening on port ${PORT}`);
});

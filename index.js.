const http = require('http');
const { Pool } = require('pg');

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false }
});

async function initDB() {
  const query = `
    CREATE TABLE IF NOT EXISTS users (
      id SERIAL PRIMARY KEY,
      email VARCHAR(255) UNIQUE NOT NULL,
      subscription_status VARCHAR(50) DEFAULT 'inactive',
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
  `;
  try {
    await pool.query(query);
    console.log('Users table verified/created successfully.');
  } catch (err) {
    console.error('Error creating users table:', err.message);
  }
}

initDB();

const server = http.createServer(async (req, res) => {
  res.setHeader('Content-Type', 'application/json');

  // Handle User Signup Endpoint: POST /signup
  if (req.method === 'POST' && req.url === '/signup') {
    let body = '';
    req.on('data', chunk => {
      body += chunk.toString();
    });
    
    req.on('end', async () => {
      try {
        const parsed = JSON.parse(body);
        const email = parsed.email;

        if (!email) {
          res.writeHead(400);
          res.end(JSON.stringify({ status: 'error', message: 'Email is required' }, null, 2));
          return;
        }

        const insertQuery = 'INSERT INTO users (email) VALUES ($1) RETURNING *';
        const result = await pool.query(insertQuery, [email]);

        res.writeHead(201);
        res.end(JSON.stringify({
          status: 'success',
          message: 'User registered successfully!',
          user: result.rows[0]
        }, null, 2));
      } catch (err) {
        res.writeHead(500);
        res.end(JSON.stringify({ status: 'error', message: err.message }, null, 2));
      }
    });
    return;
  }

  // Default Status Route
  try {
    const dbResult = await pool.query('SELECT NOW()');
    const systemData = {
      status: 'success',
      message: 'Revenue Engine database & users table active!',
      timestamp: dbResult.rows[0].now
    };
    res.writeHead(200);
    res.end(JSON.stringify(systemData, null, 2));
  } catch (err) {
    res.writeHead(500);
    res.end(JSON.stringify({ status: 'error', message: err.message }, null, 2));
  }
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
  console.log(`Server is running on port ${PORT}`);
});

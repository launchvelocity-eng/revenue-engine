.onboard-form {
  margin-top: 1.5rem;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.cyber-select {
  width: 100%;
  padding: 0.75rem;
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 4px;
  color: #00f0ff;
  font-family: inherit;
  margin-bottom: 1.5rem;
  box-sizing: border-box;
}

.cyber-select:focus {
  outline: none;
  border-color: #00f0ff;
  box-shadow: 0 0 10px rgba(0, 240, 255, 0.4);
}

.full-width {
  width: 100%;
  margin-top: 0.5rem;
}

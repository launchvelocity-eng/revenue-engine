    /* Reset parent container backgrounds to show wallpaper */
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      width: 100%;
      background-color: #020617 !important;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      position: relative;
      overflow-x: hidden;
    }

    /* Matrix Data Tunnel Wallpaper Layer */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
      background: 
        /* Perspective grid tunnel effect */
        perspective(500px) rotateX(60deg) translateY(-100px),
        /* Central cyan glowing core */
        radial-gradient(circle at 50% 35%, rgba(6, 182, 212, 0.45) 0%, rgba(2, 6, 23, 0.95) 75%),
        /* High-contrast cyber grid matrix */
        linear-gradient(rgba(34, 211, 238, 0.25) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34, 211, 238, 0.25) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
      background-position: center center;
    }

    /* Ambient pulse overlay */
    body::after {
      content: '';
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 0;
      pointer-events: none;
      background: 
        radial-gradient(circle at 20% 80%, rgba(56, 189, 248, 0.2) 0%, transparent 40%),
        radial-gradient(circle at 80% 20%, rgba(14, 165, 233, 0.2) 0%, transparent 40%);
    }

    /* Main layout container over wallpaper */
    .app-container, main, section {
      background: transparent !important;
      position: relative;
      z-index: 1;
    }

    /* Translucent Auth Card floating over Matrix */
    .auth-card {
      background: rgba(10, 15, 26, 0.78) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(34, 211, 238, 0.45) !important;
      border-radius: 20px;
      box-shadow: 0 0 50px rgba(6, 182, 212, 0.25), 0 25px 50px -12px rgba(0, 0, 0, 0.9);
    }

    body {
      background-color: #04070c;
      color: var(--text-main);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
      /* High-Tech HUD Grid & Holographic Data Matrix Background */
      background-image: 
        linear-gradient(rgba(34, 211, 238, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34, 211, 238, 0.07) 1px, transparent 1px),
        radial-gradient(circle at 50% 30%, rgba(34, 211, 238, 0.15) 0%, transparent 65%),
        radial-gradient(circle at 80% 80%, rgba(56, 189, 248, 0.1) 0%, transparent 55%);
      background-size: 36px 36px, 36px 36px, 100% 100%, 100% 100%;
      background-position: -1px -1px, -1px -1px, 0 0, 0 0;
    }

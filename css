    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: #020617 !important;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
    }

    /* Force ALL layout wrappers to be transparent so Canvas is fully visible */
    body *, main, section, .container, .app-container {
      background-color: transparent !important;
    }

    /* Floating Translucent Auth Card */
    .auth-card {
      background: rgba(10, 15, 28, 0.8) !important;
      backdrop-filter: blur(16px) !important;
      -webkit-backdrop-filter: blur(16px) !important;
      border: 1px solid rgba(34, 211, 238, 0.4) !important;
      border-radius: 20px;
      box-shadow: 0 0 50px rgba(6, 182, 212, 0.3), 0 25px 50px -12px rgba(0, 0, 0, 0.9);
      position: relative;
      z-index: 2;
    }

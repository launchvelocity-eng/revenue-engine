.cyber-panel {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 8px;
  padding: 2rem;
  margin: 2rem auto;
  max-width: 1100px;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.6);
  font-family: 'JetBrains Mono', monospace, sans-serif;
}

.cyber-badge-live {
  background: rgba(63, 185, 80, 0.15);
  color: #3fb950;
  border: 1px solid #3fb950;
  font-size: 0.7rem;
  padding: 2px 8px;
  letter-spacing: 1px;
  border-radius: 4px;
}

.panel-header h2 {
  color: #ffffff;
  margin-top: 0.5rem;
  font-size: 1.5rem;
}

.telemetry-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.metric-card {
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 6px;
  padding: 1.25rem;
}

.metric-label {
  font-size: 0.75rem;
  color: #00f0ff;
  letter-spacing: 1px;
  margin-bottom: 0.5rem;
}

.metric-value {
  font-size: 1.8rem;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 0.5rem;
}

.status-green {
  color: #3fb950;
}

.progress-bar-container {
  width: 100%;
  height: 8px;
  background: #21262d;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 0.5rem;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #00f0ff, #3fb950);
  transition: width 0.5s ease-in-out;
}

.metric-subtext {
  font-size: 0.8rem;
  color: #8b949e;
}

.audit-log-container {
  margin-top: 2rem;
}

.audit-log-container h3 {
  font-size: 1rem;
  color: #8b949e;
  margin-bottom: 0.75rem;
}

.log-terminal {
  background: #05070f;
  border: 1px solid #21262d;
  border-radius: 6px;
  padding: 1rem;
  height: 140px;
  overflow-y: auto;
  font-size: 0.8rem;
  color: #e6edf3;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.log-entry.system { color: #00f0ff; }
.log-entry.success { color: #3fb950; }
.log-entry.audit { color: #e3b341; }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background-color: #020617 !important;
      /* Glowing Cyber Matrix & Holographic Grid Wallpaper */
      background-image: 
        radial-gradient(circle at 50% 30%, rgba(6, 182, 212, 0.45) 0%, transparent 70%),
        radial-gradient(circle at 15% 85%, rgba(56, 189, 248, 0.35) 0%, transparent 60%),
        linear-gradient(rgba(34, 211, 238, 0.18) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34, 211, 238, 0.18) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 36px 36px, 36px 36px;
      background-attachment: fixed;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Ensure wrapper containers don't block the wallpaper */
    div, main, section {
      background: transparent;
    }

    /* Translucent Glassmorphism Card */
    .auth-card {
      background: rgba(10, 15, 28, 0.82) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(34, 211, 238, 0.45) !important;
      border-radius: 20px;
      width: 100%;
      max-width: 500px;
      padding: 40px;
      box-shadow: 0 0 50px rgba(6, 182, 212, 0.25), 0 25px 50px -12px rgba(0, 0, 0, 0.95);
    }

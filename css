    body {
      background-color: #04070c;
      color: var(--text-main);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
      /* Futuristic HUD Grid & Glowing Data Matrix Background */
      background-image: 
        linear-gradient(rgba(30, 41, 59, 0.25) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30, 41, 59, 0.25) 1px, transparent 1px),
        radial-gradient(circle at 50% 30%, rgba(34, 211, 238, 0.12) 0%, transparent 60%),
        radial-gradient(circle at 80% 80%, rgba(56, 189, 248, 0.08) 0%, transparent 50%);
      background-size: 40px 40px, 40px 40px, 100% 100%, 100% 100%;
      background-position: -1px -1px, -1px -1px, 0 0, 0 0;
    }

    /* Ambient Pulsing Glow Overlay */
    body::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(circle at 50% 20%, rgba(34, 211, 238, 0.08), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

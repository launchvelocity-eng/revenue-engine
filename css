/* Gatekeeper Bar & Modal Styles */
.gatekeeper-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 20px;
  background: #111827;
  border-bottom: 1px solid #1f2937;
  color: #f3f4f6;
  font-family: system-ui, -apple-system, sans-serif;
}

.badge {
  padding: 4px 10px;
  border-radius: 9999px;
  font-size: 0.85rem;
  font-weight: 600;
}
.badge.locked { background: #991b1b; color: #fecaca; }
.badge.authenticated { background: #065f46; color: #a7f3d0; }

.tenant-label {
  margin-left: 12px;
  font-size: 0.85rem;
  color: #9ca3af;
}

/* Modal Layout */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}
.modal-overlay.hidden { display: none; }

.modal-card {
  background: #1f2937;
  border: 1px solid #374151;
  border-radius: 8px;
  width: 100%;
  max-width: 480px;
  padding: 24px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
  color: #f3f4f6;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #374151;
  padding-bottom: 12px;
  margin-bottom: 16px;
}
.modal-header h3 { margin: 0; font-size: 1.15rem; }
.close-btn { background: none; border: none; color: #9ca3af; font-size: 1.5rem; cursor: pointer; }

.modal-description { font-size: 0.875rem; color: #9ca3af; line-height: 1.4; margin-bottom: 16px; }
.modal-description code { background: #111827; padding: 2px 6px; border-radius: 4px; color: #60a5fa; }

.form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.form-group label { font-size: 0.85rem; color: #d1d5db; font-weight: 500; }
.form-group input {
  padding: 10px 12px;
  background: #111827;
  border: 1px solid #374151;
  border-radius: 6px;
  color: #ffffff;
  font-size: 0.9rem;
}
.form-group input:focus { outline: none; border-color: #3b82f6; }

.modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
.btn { padding: 8px 16px; border-radius: 6px; border: none; font-size: 0.875rem; cursor: pointer; font-weight: 500; }
.btn-primary { background: #2563eb; color: #ffffff; }
.btn-secondary { background: #374151; color: #f3f4f6; }
.btn-danger { background: #dc2626; color: #ffffff; }

.feedback-msg { padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 16px; }
.feedback-msg.success { background: #064e3b; color: #a7f3d0; }
.feedback-msg.error { background: #7f1d1d; color: #fecaca; }

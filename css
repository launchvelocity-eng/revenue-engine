    body {
      background-color: #020617;
      color: var(--text-main);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
      /* Immersive Cyber Digital Matrix & Holographic Grid Wallpaper */
      background-image: 
        radial-gradient(circle at 50% 20%, rgba(6, 182, 212, 0.25) 0%, transparent 60%),
        radial-gradient(circle at 20% 80%, rgba(56, 189, 248, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 90%, rgba(14, 165, 233, 0.18) 0%, transparent 55%),
        linear-gradient(rgba(14, 165, 233, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(14, 165, 233, 0.05) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 100% 100%, 30px 30px, 30px 30px;
      background-position: 0 0, 0 0, 0 0, -1px -1px, -1px -1px;
    }

    /* Floating Data Stream Glow Effect */
    body::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(ellipse at center, rgba(34, 211, 238, 0.12) 0%, rgba(2, 6, 23, 0.8) 80%);
      pointer-events: none;
      z-index: 0;
    }

    .auth-card {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: 20px;
      width: 100%;
      max-width: 500px;
      padding: 40px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9), 0 0 40px rgba(14, 165, 233, 0.15);
      position: relative;
      z-index: 1;
    }

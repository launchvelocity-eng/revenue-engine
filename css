    body {
      background-color: #030712;
      color: var(--text-main);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
      /* High-Tech HUD Grid & Glowing Matrix Background */
      background-image: 
        linear-gradient(rgba(34, 211, 238, 0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34, 211, 238, 0.12) 1px, transparent 1px),
        radial-gradient(circle at 50% 30%, rgba(34, 211, 238, 0.22) 0%, transparent 70%),
        radial-gradient(circle at 85% 85%, rgba(56, 189, 248, 0.15) 0%, transparent 60%);
      background-size: 36px 36px, 36px 36px, 100% 100%, 100% 100%;
      background-position: -1px -1px, -1px -1px, 0 0, 0 0;
    }

    .auth-card {
      background: rgba(15, 20, 29, 0.9);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(34, 211, 238, 0.3);
      border-radius: 20px;
      width: 100%;
      max-width: 500px;
      padding: 40px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 30px rgba(34, 211, 238, 0.1);
    }
